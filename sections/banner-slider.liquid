<section
  id="BannerSlider-{{ section.id }}"
  class="custom-banner-slider"
  data-banner-slider-section
  data-autoplay="{{ section.settings.autoplay }}"
  data-autoplay-speed="{{ section.settings.autoplay_seconds | times: 1000 }}"
  data-effect="{{ section.settings.slide_effect }}"
>
  <div class="custom-banner-slider__track">
    {% for block in section.blocks %}
      {% liquid
        assign desktop_image = block.settings.desktop_image
        assign mobile_image = block.settings.mobile_image
        assign image_alt = block.settings.alt_text | default: desktop_image.alt
      %}

      <div
        class="custom-banner-slider__slide"
        {{ block.shopify_attributes }}
      >
        {% if block.settings.link != blank %}
          <a
            href="{{ block.settings.link }}"
            class="custom-banner-slider__link"
          >
        {% endif %}

        {% if desktop_image != blank %}
          <picture class="custom-banner-slider__picture">
            {% if mobile_image != blank %}
              <source
                media="(max-width: 748px)"
                srcset="
                  {{ mobile_image | image_url: width: 375 }} 375w,
                  {{ mobile_image | image_url: width: 750 }} 750w,
                  {{ mobile_image | image_url: width: 1100 }} 1100w,
                  {{ mobile_image | image_url: width: 1500 }} 1500w
                "
                sizes="100vw"
                width="{{ mobile_image.width }}"
                height="{{ mobile_image.height }}"
              >
            {% endif %}

            <img
              src="{{ desktop_image | image_url: width: 1920 }}"
              srcset="
                {{ desktop_image | image_url: width: 750 }} 750w,
                {{ desktop_image | image_url: width: 1100 }} 1100w,
                {{ desktop_image | image_url: width: 1500 }} 1500w,
                {{ desktop_image | image_url: width: 1920 }} 1920w,
                {{ desktop_image | image_url: width: 2560 }} 2560w,
                {{ desktop_image | image_url: width: 3840 }} 3840w
              "
              sizes="100vw"
              width="{{ desktop_image.width }}"
              height="{{ desktop_image.height }}"
              alt="{{ image_alt | escape }}"
              {% if forloop.first %}
                loading="eager"
              {% else %}
                loading="lazy"
              {% endif %}
            >
          </picture>
        {% else %}
          {{ 'lifestyle-1' | placeholder_svg_tag: 'custom-banner-slider__placeholder' }}
        {% endif %}

        {% if block.settings.link != blank %}
          </a>
        {% endif %}
      </div>
    {% endfor %}
  </div>

  {% if section.settings.autoplay and section.blocks.size > 1 %}
    <button
      type="button"
      class="custom-banner-slider__pause"
      aria-label="Pause slideshow"
      hidden
    >
      Pause
    </button>
  {% endif %}
</section>

<style>
  .custom-banner-slider {
    position: relative;
    width: 100%;
  }

  .custom-banner-slider__track {
    width: 100%;
    margin: 0;
  }

  .custom-banner-slider__track:not(.slick-initialized)
    > .custom-banner-slider__slide:not(:first-child) {
    display: none;
  }

  .custom-banner-slider__slide {
    height: auto;
    min-height: 0;
    overflow: hidden;
  }

  .custom-banner-slider__link,
  .custom-banner-slider__picture {
    display: block;
    width: 100%;
  }

  .custom-banner-slider__picture img,
  .custom-banner-slider__placeholder {
    display: block;
    width: 100%;
    max-width: 100%;
    height: auto;
  }

  .custom-banner-slider .slick-list,
  .custom-banner-slider .slick-track {
    margin: 0;
  }

  .custom-banner-slider .slick-slide {
    height: auto;
  }

  /* Zoom animation combined with Slick's fade effect. */
  .custom-banner-slider[data-effect="zoom"]
    .slick-initialized
    .custom-banner-slider__picture {
    transform: scale(1.06);
    transition: transform 900ms ease;
  }

  .custom-banner-slider[data-effect="zoom"]
    .slick-active
    .custom-banner-slider__picture {
    transform: scale(1);
  }

  /* Soft opacity transition combined with horizontal sliding. */
  .custom-banner-slider[data-effect="soft_slide"]
    .slick-initialized
    .custom-banner-slider__picture {
    opacity: 0.35;
    transition: opacity 700ms ease;
  }

  .custom-banner-slider[data-effect="soft_slide"]
    .slick-active
    .custom-banner-slider__picture {
    opacity: 1;
  }

  .custom-banner-slider__arrow {
    position: absolute;
    top: 50%;
    z-index: 3;
    display: flex;
    align-items: center;
    justify-content: center;
    width: 42px;
    height: 42px;
    padding: 0;
    border: 0;
    border-radius: 50%;
    background: #ffffff;
    color: #111111;
    cursor: pointer;
    transform: translateY(-50%);
    box-shadow: 0 2px 10px #00000020;
  }

  .custom-banner-slider__arrow--prev {
    left: 15px;
  }

  .custom-banner-slider__arrow--next {
    right: 15px;
  }

  .custom-banner-slider__arrow svg {
    width: 20px;
    height: 20px;
  }

  .custom-banner-slider .slick-dots {
    position: absolute;
    bottom: 15px;
    left: 50%;
    z-index: 3;
    display: flex;
    justify-content: center;
    gap: 8px;
    width: auto;
    max-width: calc(100% - 160px);
    margin: 0;
    padding: 0;
    list-style: none;
    line-height: 1;
    transform: translateX(-50%);
  }

  .custom-banner-slider .slick-dots li {
    width: auto;
    height: auto;
    margin: 0;
    padding: 0;
  }

  .custom-banner-slider .slick-dots button {
    display: block;
    width: 10px;
    height: 10px;
    padding: 0;
    border: 1px solid #ffffff;
    border-radius: 50%;
    background: #ffffff70;
    font-size: 0;
    cursor: pointer;
    box-shadow: 0 1px 4px #00000040;
  }

  .custom-banner-slider .slick-dots button::before {
    display: none;
  }

  .custom-banner-slider .slick-dots .slick-active button {
    background: #ffffff;
  }

  .custom-banner-slider__pause {
    position: absolute;
    right: 12px;
    bottom: 10px;
    z-index: 4;
    padding: 6px 10px;
    border: 0;
    border-radius: 4px;
    background: #ffffff;
    color: #111111;
    font-size: 12px;
    cursor: pointer;
  }

  .custom-banner-slider__pause[hidden] {
    display: none;
  }

  .custom-banner-slider button:focus-visible {
    outline: 2px solid #111111;
    outline-offset: 3px;
  }

  @media screen and (max-width: 748px) {
    .custom-banner-slider__arrow {
      width: 32px;
      height: 32px;
    }

    .custom-banner-slider__arrow--prev {
      left: 8px;
    }

    .custom-banner-slider__arrow--next {
      right: 8px;
    }

    .custom-banner-slider .slick-dots {
      bottom: 12px;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .custom-banner-slider .custom-banner-slider__picture {
      transition: none !important;
      transform: none !important;
    }
  }
</style>

<script>
  (function () {
    var sectionSelector = '[data-banner-slider-section]';

    function initializeSlider(section) {
      var $ = window.jQuery;
      if (!$ || !$.fn || !$.fn.slick) return;

      var $slider = $(section).find('.custom-banner-slider__track');

      if (
        !$slider.length ||
        $slider.hasClass('slick-initialized') ||
        !$slider.children().length
      ) {
        return;
      }

      var hasMultipleSlides = $slider.children().length > 1;
      var effect = section.dataset.effect || 'slide';
      var autoplayEnabled =
        section.dataset.autoplay === 'true' && hasMultipleSlides;
      var autoplaySpeed =
        parseInt(section.dataset.autoplaySpeed, 10) || 5000;
      var reducedMotion = window.matchMedia(
        '(prefers-reduced-motion: reduce)'
      ).matches;

      var useFade = effect === 'fade' || effect === 'zoom';
      var transitionSpeed = 500;

      if (effect === 'fade') transitionSpeed = 600;
      if (effect === 'zoom') transitionSpeed = 900;
      if (effect === 'soft_slide') transitionSpeed = 700;

      // Respect reduced-motion preference on initial load.
      var shouldAutoplay = autoplayEnabled && !reducedMotion;
      var manuallyPaused = !shouldAutoplay;
      var pauseButton = section.querySelector(
        '.custom-banner-slider__pause'
      );

      function updatePauseButton() {
        if (!pauseButton) return;

        pauseButton.textContent = manuallyPaused ? 'Play' : 'Pause';
        pauseButton.setAttribute(
          'aria-label',
          manuallyPaused ? 'Play slideshow' : 'Pause slideshow'
        );
      }

      $slider.slick({
        slidesToShow: 1,
        slidesToScroll: 1,
        arrows: hasMultipleSlides,
        dots: hasMultipleSlides,
        infinite: hasMultipleSlides,
        autoplay: shouldAutoplay,
        autoplaySpeed: autoplaySpeed,
        speed: reducedMotion ? 0 : transitionSpeed,
        fade: useFade,
        cssEase:
          effect === 'soft_slide'
            ? 'cubic-bezier(0.22, 1, 0.36, 1)'
            : 'ease',
        adaptiveHeight: true,
        pauseOnHover: true,
        pauseOnFocus: true,
        swipe: true,
        draggable: true,
        accessibility: true,
        prevArrow:
          '<button type="button" class="custom-banner-slider__arrow custom-banner-slider__arrow--prev" aria-label="Previous banner">' +
          '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">' +
          '<path d="M15 18l-6-6 6-6"/></svg></button>',
        nextArrow:
          '<button type="button" class="custom-banner-slider__arrow custom-banner-slider__arrow--next" aria-label="Next banner">' +
          '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">' +
          '<path d="M9 6l6 6-6 6"/></svg></button>'
      });

      $slider.find('img').on('load.bannerSlider', function () {
        if ($slider.hasClass('slick-initialized')) {
          $slider.slick('setPosition');
        }
      });

      if (pauseButton) {
        pauseButton.hidden = false;
        updatePauseButton();

        $(pauseButton).on('click.bannerSlider', function () {
          manuallyPaused = !manuallyPaused;

          $slider.slick(manuallyPaused ? 'slickPause' : 'slickPlay');
          updatePauseButton();
        });
      }

      // Keep the selected block visible in the Theme Editor.
      $(section).on('shopify:block:select.bannerSlider', function (event) {
        var $slide = $(event.target).closest(
          '.custom-banner-slider__slide'
        );
        var index = parseInt($slide.attr('data-slick-index'), 10);

        $slider.slick('slickPause');

        if (!isNaN(index)) {
          $slider.slick('slickGoTo', index, true);
        }
      });

      $(section).on('shopify:block:deselect.bannerSlider', function () {
        if (autoplayEnabled && !manuallyPaused) {
          $slider.slick('slickPlay');
        }
      });
    }

    function initializeAllSliders() {
      document.querySelectorAll(sectionSelector).forEach(initializeSlider);
    }

    if (document.readyState === 'loading') {
      document.addEventListener('DOMContentLoaded', initializeAllSliders);
    } else {
      initializeAllSliders();
    }

    window.addEventListener('load', initializeAllSliders);

    document.addEventListener('shopify:section:load', function (event) {
      event.target.querySelectorAll(sectionSelector).forEach(initializeSlider);
    });

    document.addEventListener('shopify:section:unload', function (event) {
      var $ = window.jQuery;
      if (!$ || !$.fn || !$.fn.slick) return;

      $(event.target).find(sectionSelector).each(function () {
        var $section = $(this);
        var $slider = $section.find('.custom-banner-slider__track');

        $section.off('.bannerSlider');
        $section.find('.custom-banner-slider__pause').off('.bannerSlider');
        $slider.find('img').off('.bannerSlider');

        if ($slider.hasClass('slick-initialized')) {
          $slider.slick('unslick');
        }
      });
    });
  })();
</script>

{% schema %}
{
  "name": "Banner Slider",
  "tag": "section",
  "class": "banner-slider-section",
  "max_blocks": 12,
  "settings": [
    {
      "type": "checkbox",
      "id": "autoplay",
      "label": "Enable autoplay",
      "default": false
    },
    {
      "type": "range",
      "id": "autoplay_seconds",
      "label": "Change slide every",
      "min": 2,
      "max": 15,
      "step": 1,
      "unit": "s",
      "default": 5,
      "info": "Applies when autoplay is enabled."
    },
    {
      "type": "select",
      "id": "slide_effect",
      "label": "Slide effect",
      "options": [
        {
          "value": "slide",
          "label": "Slide"
        },
        {
          "value": "fade",
          "label": "Fade"
        },
        {
          "value": "zoom",
          "label": "Zoom Fade"
        },
        {
          "value": "soft_slide",
          "label": "Soft Slide"
        }
      ],
      "default": "slide"
    }
  ],
  "blocks": [
    {
      "type": "banner",
      "name": "Banner",
      "settings": [
        {
          "type": "image_picker",
          "id": "desktop_image",
          "label": "Desktop image"
        },
        {
          "type": "image_picker",
          "id": "mobile_image",
          "label": "Mobile image",
          "info": "Optional. Below 749px, this image is shown. If empty, the desktop image is used."
        },
        {
          "type": "url",
          "id": "link",
          "label": "Banner link"
        },
        {
          "type": "text",
          "id": "alt_text",
          "label": "Image description",
          "info": "Describe the banner for accessibility."
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Banner Slider",
      "blocks": [
        {
          "type": "banner"
        },
        {
          "type": "banner"
        }
      ]
    }
  ]
}
{% endschema %}
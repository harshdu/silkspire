<section
  id="CategoryGrid-{{ section.id }}"
  class="category-image-grid"
>
  <div class="category-image-grid__wrapper">
    {% for block in section.blocks %}
      {% liquid
        assign card_image = block.settings.image
        assign image_alt = card_image.alt | default: block.settings.title
      %}

      <div
        class="category-image-grid__item"
        {{ block.shopify_attributes }}
      >
        {% if block.settings.link != blank %}
          <a
            href="{{ block.settings.link }}"
            class="category-image-grid__card"
          >
        {% else %}
          <div class="category-image-grid__card">
        {% endif %}

          {% if card_image != blank %}
            {{
              card_image
              | image_url: width: 1500
              | image_tag:
                class: 'category-image-grid__image',
                widths: '240, 360, 480, 750, 1000, 1500',
                sizes: '(max-width: 748px) 50vw, 25vw',
                loading: 'lazy',
                alt: image_alt
            }}
          {% else %}
            {{
              'collection-1'
              | placeholder_svg_tag: 'category-image-grid__placeholder'
            }}
          {% endif %}

          <div class="category-image-grid__overlay"></div>

          {% if block.settings.title != blank %}
            <div class="category-image-grid__content">
              <h2 class="category-image-grid__title">
                {{ block.settings.title | escape }}
              </h2>
            </div>
          {% endif %}

        {% if block.settings.link != blank %}
          </a>
        {% else %}
          </div>
        {% endif %}
      </div>
    {% endfor %}
  </div>
</section>

{% style %}
  #CategoryGrid-{{ section.id }} {
    --card-gap: {{ section.settings.card_gap }}px;
    --heading-color: {{ section.settings.heading_color }};
    --heading-size: {{ section.settings.heading_size }}px;
    --mobile-heading-size: {{ section.settings.mobile_heading_size }}px;

    display: block;
    width: 100%;
    margin: 0;
    padding: 0;
  }

  #CategoryGrid-{{ section.id }} .category-image-grid__wrapper {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: var(--card-gap);
    width: 100%;
  }

  #CategoryGrid-{{ section.id }} .category-image-grid__item {
    min-width: 0;
  }

  #CategoryGrid-{{ section.id }} .category-image-grid__card {
    position: relative;
    display: block;
    width: 100%;
    aspect-ratio: 2 / 3;
    overflow: hidden;
    color: var(--heading-color);
    text-decoration: none;
    background: #E5E4E2;
  }

  #CategoryGrid-{{ section.id }} .category-image-grid__image,
  #CategoryGrid-{{ section.id }} .category-image-grid__placeholder {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  #CategoryGrid-{{ section.id }} .category-image-grid__overlay {
    position: absolute;
    inset: 0;
    pointer-events: none;
    background: linear-gradient(
      to bottom,
      rgba(0, 0, 0, 0) 45%,
      rgba(0, 0, 0, 0.12) 65%,
      rgba(0, 0, 0, 0.68) 100%
    );
  }

  #CategoryGrid-{{ section.id }} .category-image-grid__content {
    position: absolute;
    right: 12px;
    bottom: 9%;
    left: 12px;
    z-index: 1;
    text-align: center;
  }

  #CategoryGrid-{{ section.id }} .category-image-grid__title {
    margin: 0;
    padding: 0;
    color: var(--heading-color);
    font-family: Georgia, "Times New Roman", serif;
    font-size: clamp(20px, 2.6vw, var(--heading-size));
    font-weight: 700;
    line-height: 1.1;
    letter-spacing: 0;
    text-transform: uppercase;
    overflow-wrap: anywhere;
  }

  #CategoryGrid-{{ section.id }} a.category-image-grid__card:focus-visible {
    outline: 3px solid var(--heading-color);
    outline-offset: -6px;
  }

  @media screen and (max-width: 748px) {
    #CategoryGrid-{{ section.id }} .category-image-grid__wrapper {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }

    #CategoryGrid-{{ section.id }} .category-image-grid__content {
      right: 8px;
      left: 8px;
    }

    #CategoryGrid-{{ section.id }} .category-image-grid__title {
      font-size: var(--mobile-heading-size);
    }
  }
{% endstyle %}

{% schema %}
{
  "name": "Category Image Grid",
  "tag": "section",
  "class": "category-image-grid-section",
  "max_blocks": 4,
  "settings": [
    {
      "type": "range",
      "id": "card_gap",
      "label": "Space between images",
      "min": 0,
      "max": 20,
      "step": 1,
      "unit": "px",
      "default": 4
    },
    {
      "type": "color",
      "id": "heading_color",
      "label": "Heading color",
      "default": "#6F4E37"
    },
    {
      "type": "range",
      "id": "heading_size",
      "label": "Desktop heading size",
      "min": 20,
      "max": 72,
      "step": 2,
      "unit": "px",
      "default": 48
    },
    {
      "type": "range",
      "id": "mobile_heading_size",
      "label": "Mobile heading size",
      "min": 14,
      "max": 36,
      "step": 1,
      "unit": "px",
      "default": 24
    }
  ],
  "blocks": [
    {
      "type": "category",
      "name": "Category",
      "settings": [
        {
          "type": "image_picker",
          "id": "image",
          "label": "Category image",
          "info": "Use a portrait image with a 2:3 ratio for the reference layout."
        },
        {
          "type": "text",
          "id": "title",
          "label": "Heading",
          "default": "Category"
        },
        {
          "type": "url",
          "id": "link",
          "label": "Category link"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Category Image Grid",
      "blocks": [
        {
          "type": "category",
          "settings": {
            "title": "CO-ORDS"
          }
        },
        {
          "type": "category",
          "settings": {
            "title": "KURTAS"
          }
        },
        {
          "type": "category",
          "settings": {
            "title": "SUITS"
          }
        },
        {
          "type": "category",
          "settings": {
            "title": "SAREES"
          }
        }
      ]
    }
  ]
}
{% endschema %}
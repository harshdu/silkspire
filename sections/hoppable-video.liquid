{% liquid
  assign section_id = 'dwell-shoppable-video-' | append: section.id
%}


<section
  id="{{ section_id }}"
  class="dwell-shoppable-video-section"
  data-dwell-shoppable-video
>
  <div class="page-width-desktop">


    {% if section.settings.heading != blank or section.settings.subheading != blank %}
      <div class="dwell-sv-heading-wrap">
        {% if section.settings.heading != blank %}
          <h2 class="dwell-sv-heading h1 title-wrapper--self-padded-tablet-down">
            {{ section.settings.heading }}
          </h2>
        {% endif %}


        {% if section.settings.subheading != blank %}
          <p class="dwell-sv-subheading">
            {{ section.settings.subheading }}
          </p>
        {% endif %}
      </div>
    {% endif %}


    {% if section.blocks.size > 0 %}
      <div class="dwell-sv-slider-wrap">
        <button
          type="button"
          class="dwell-sv-nav dwell-sv-nav-prev"
          data-sv-prev
          aria-label="Previous videos"
        >
          ‹
        </button>


        <div class="dwell-sv-track" data-sv-track>
          {% for block in section.blocks %}
            {% liquid
              assign card_product = block.settings.product
              assign card_variant = card_product.selected_or_first_available_variant
              assign card_title = block.settings.title | default: card_product.title
            %}


            <div class="dwell-sv-card" {{ block.shopify_attributes }}>
              <button
                type="button"
                class="dwell-sv-video-button"
                data-sv-open
                data-modal-index="{{ forloop.index0 }}"
                aria-label="Open video"
              >
                <div class="dwell-sv-video-box">


                  {% if block.settings.video != blank %}
                    {{
                      block.settings.video
                      | video_tag:
                        image_size: '700x',
                        autoplay: true,
                        loop: true,
                        muted: true,
                        controls: false
                    }}
                  {% elsif block.settings.video_url != blank %}
                    {% assign video_id = block.settings.video_url.id %}


                    {% if block.settings.video_url.type == 'youtube' %}
                      <iframe
                        src="https://www.youtube.com/embed/{{ video_id }}?mute=1&autoplay=1&loop=1&playlist={{ video_id }}&controls=0&playsinline=1"
                        title="{{ card_title | escape }}"
                        allow="autoplay; encrypted-media"
                        loading="lazy"
                      ></iframe>
                    {% elsif block.settings.video_url.type == 'vimeo' %}
                      <iframe
                        src="https://player.vimeo.com/video/{{ video_id }}?muted=1&autoplay=1&loop=1&controls=0"
                        title="{{ card_title | escape }}"
                        allow="autoplay; encrypted-media"
                        loading="lazy"
                      ></iframe>
                    {% endif %}
                  {% elsif block.settings.poster != blank %}
                    <img
                      src="{{ block.settings.poster | image_url: width: 700 }}"
                      alt="{{ card_title | escape }}"
                      loading="lazy"
                      width="700"
                      height="900"
                    >
                  {% else %}
                    <div class="dwell-sv-placeholder">
                      Add video
                    </div>
                  {% endif %}


                  <span class="dwell-sv-play-icon" aria-hidden="true">
                    ▶
                  </span>
                </div>
              </button>


              {% if card_product != blank %}
                <div class="dwell-sv-product-card">
                  <a href="{{ card_product.url }}" class="dwell-sv-product-image">
                    {% if card_variant.featured_image != blank %}
                      <img
                        src="{{ card_variant.featured_image | image_url: width: 240 }}"
                        alt="{{ card_variant.featured_image.alt | default: card_product.title | escape }}"
                        loading="lazy"
                        width="240"
                        height="240"
                      >
                    {% elsif card_product.featured_image != blank %}
                      <img
                        src="{{ card_product.featured_image | image_url: width: 240 }}"
                        alt="{{ card_product.featured_image.alt | default: card_product.title | escape }}"
                        loading="lazy"
                        width="240"
                        height="240"
                      >
                    {% endif %}
                  </a>


                  <div class="dwell-sv-product-info">
                    <a href="{{ card_product.url }}" class="dwell-sv-product-title">
                      {{ card_product.title }}
                    </a>


                    <div class="dwell-sv-price-row">
                      <span class="dwell-sv-price">
                        {{ card_product.price | money }}
                      </span>


                      {% if card_product.compare_at_price > card_product.price %}
                        <span class="dwell-sv-compare">
                          {{ card_product.compare_at_price | money }}
                        </span>
                      {% endif %}
                    </div>
                  </div>
                </div>


                {% if card_product.available %}
                  {% if card_product.has_only_default_variant %}
                    <button
                      type="button"
                      class="dwell-sv-add-btn"
                      data-sv-add
                      data-variant-id="{{ card_variant.id }}"
                    >
                      {{ section.settings.button_text }}
                    </button>
                  {% else %}
                    <a href="{{ card_product.url }}" class="dwell-sv-add-btn dwell-sv-link-btn">
                      Choose Options
                    </a>
                  {% endif %}
                {% else %}
                  <a href="{{ card_product.url }}" class="dwell-sv-add-btn dwell-sv-link-btn dwell-sv-soldout">
                    {{ section.settings.soldout_text }}
                  </a>
                {% endif %}
              {% endif %}
            </div>
          {% endfor %}
        </div>


        <button
          type="button"
          class="dwell-sv-nav dwell-sv-nav-next"
          data-sv-next
          aria-label="Next videos"
        >
          ›
        </button>
      </div>


      <div class="dwell-sv-modal" data-sv-modal hidden>
        <button
          type="button"
          class="dwell-sv-modal-close"
          data-sv-close
          aria-label="Close video"
        >
          ×
        </button>


        <div class="dwell-sv-modal-overlay" data-sv-overlay></div>


        <div class="dwell-sv-modal-content">
          {% for block in section.blocks %}
            {% liquid
              assign modal_product = block.settings.product
              assign modal_variant = modal_product.selected_or_first_available_variant
              assign modal_title = block.settings.title | default: modal_product.title
            %}


            <div
              class="dwell-sv-modal-panel"
              data-sv-panel="{{ forloop.index0 }}"
              hidden
            >
              <div class="dwell-sv-modal-video">
                {% if block.settings.video != blank %}
                  {{
                    block.settings.video
                    | video_tag:
                      image_size: '900x',
                      autoplay: false,
                      loop: true,
                      muted: false,
                      controls: true
                  }}
                {% elsif block.settings.video_url != blank %}
                  {% assign modal_video_id = block.settings.video_url.id %}


                  {% if block.settings.video_url.type == 'youtube' %}
                    <iframe
                      data-src="https://www.youtube.com/embed/{{ modal_video_id }}?autoplay=1&rel=0&playsinline=1"
                      title="{{ modal_title | escape }}"
                      allow="autoplay; encrypted-media"
                      allowfullscreen
                      loading="lazy"
                    ></iframe>
                  {% elsif block.settings.video_url.type == 'vimeo' %}
                    <iframe
                      data-src="https://player.vimeo.com/video/{{ modal_video_id }}?autoplay=1"
                      title="{{ modal_title | escape }}"
                      allow="autoplay; encrypted-media"
                      allowfullscreen
                      loading="lazy"
                    ></iframe>
                  {% endif %}
                {% elsif block.settings.poster != blank %}
                  <img
                    src="{{ block.settings.poster | image_url: width: 900 }}"
                    alt="{{ modal_title | escape }}"
                    loading="lazy"
                    width="900"
                    height="1200"
                  >
                {% endif %}
              </div>


              {% if modal_product != blank %}
                <div class="dwell-sv-modal-product">
                  <div class="dwell-sv-modal-product-row">
                    <a href="{{ modal_product.url }}" class="dwell-sv-modal-product-img">
                      {% if modal_variant.featured_image != blank %}
                        <img
                          src="{{ modal_variant.featured_image | image_url: width: 260 }}"
                          alt="{{ modal_variant.featured_image.alt | default: modal_product.title | escape }}"
                          loading="lazy"
                          width="260"
                          height="260"
                        >
                      {% elsif modal_product.featured_image != blank %}
                        <img
                          src="{{ modal_product.featured_image | image_url: width: 260 }}"
                          alt="{{ modal_product.featured_image.alt | default: modal_product.title | escape }}"
                          loading="lazy"
                          width="260"
                          height="260"
                        >
                      {% endif %}
                    </a>


                    <div class="dwell-sv-modal-product-info">
                      <a href="{{ modal_product.url }}" class="dwell-sv-modal-product-title">
                        {{ modal_product.title }}
                      </a>


                      <div class="dwell-sv-price-row">
                        <span class="dwell-sv-price">
                          {{ modal_product.price | money }}
                        </span>


                        {% if modal_product.compare_at_price > modal_product.price %}
                          <span class="dwell-sv-compare">
                            {{ modal_product.compare_at_price | money }}
                          </span>
                        {% endif %}
                      </div>
                    </div>
                  </div>


                  {% if modal_product.available %}
                    {% if modal_product.has_only_default_variant %}
                      <button
                        type="button"
                        class="dwell-sv-add-btn"
                        data-sv-add
                        data-variant-id="{{ modal_variant.id }}"
                      >
                        {{ section.settings.button_text }}
                      </button>
                    {% else %}
                      <a href="{{ modal_product.url }}" class="dwell-sv-add-btn dwell-sv-link-btn">
                        Choose Options
                      </a>
                    {% endif %}
                  {% else %}
                    <a href="{{ modal_product.url }}" class="dwell-sv-add-btn dwell-sv-link-btn dwell-sv-soldout">
                      {{ section.settings.soldout_text }}
                    </a>
                  {% endif %}
                </div>
              {% endif %}
            </div>
          {% endfor %}
        </div>
      </div>
    {% else %}
      <div class="dwell-sv-empty">
        Add shoppable video blocks from the theme editor.
      </div>
    {% endif %}


  </div>
</section>


<style>
  #{{ section_id }},
  #{{ section_id }} * {
    box-sizing: border-box;
  }


  #{{ section_id }} {
    width: 100%;
    margin: {{ section.settings.margin_top }}px 0 {{ section.settings.margin_bottom }}px;
    padding: {{ section.settings.padding_top }}px 0 {{ section.settings.padding_bottom }}px;
    background: {{ section.settings.background_color }};
    color: {{ section.settings.text_color }};
    overflow: hidden;
  }


  #{{ section_id }} .dwell-sv-container {
    width: 100%;
    max-width: {% if section.settings.full_width %}100%{% else %}{{ section.settings.content_width }}px{% endif %};
    margin: 0 auto;
    padding: 0 {{ section.settings.side_padding_mobile }}px;
  }


  #{{ section_id }} .dwell-sv-heading-wrap {
    margin-bottom: 18px;
    text-align: {{ section.settings.heading_alignment }};
  }


  #{{ section_id }} .dwell-sv-heading {
    margin: 0;
    font-size: {{ section.settings.heading_size_mobile }}px;
    line-height: 1.15;
    color: {{ section.settings.text_color }};
  }


  #{{ section_id }} .dwell-sv-subheading {
    margin: 6px 0 0;
    font-size: 14px;
    line-height: 1.4;
    color: {{ section.settings.muted_text_color }};
  }


  #{{ section_id }} .dwell-sv-slider-wrap {
    position: relative;
    width: 100%;
  }


  #{{ section_id }} .dwell-sv-track {
    width: 100%;
    display: flex;
    gap: {{ section.settings.card_gap }}px;
    overflow-x: auto;
    scroll-snap-type: x mandatory;
    scroll-behavior: smooth;
    -webkit-overflow-scrolling: touch;
    scrollbar-width: none;
    padding-bottom: 4px;
  }


  #{{ section_id }} .dwell-sv-track::-webkit-scrollbar {
    display: none;
  }


  #{{ section_id }} .dwell-sv-card {
    flex: 0 0 {{ section.settings.mobile_card_width }}%;
    scroll-snap-align: start;
    overflow: hidden;
    border: 1px solid {{ section.settings.card_border_color }};
    border-radius: {{ section.settings.card_radius }}px;
    background: {{ section.settings.card_background }};
  }


  #{{ section_id }} .dwell-sv-video-button {
    display: block;
    width: 100%;
    padding: 0;
    margin: 0;
    border: 0;
    background: transparent;
    cursor: pointer;
    appearance: none;
    -webkit-appearance: none;
  }


  #{{ section_id }} .dwell-sv-video-box {
    position: relative;
    width: 100%;
    aspect-ratio: {{ section.settings.video_ratio }};
    overflow: hidden;
    background: #f2f2f2;
  }


  #{{ section_id }} .dwell-sv-video-box video,
  #{{ section_id }} .dwell-sv-video-box iframe,
  #{{ section_id }} .dwell-sv-video-box img {
    display: block;
    width: 100%;
    height: 100%;
    border: 0;
    object-fit: cover;
  }


  #{{ section_id }} .dwell-sv-video-box::after {
    content: "";
    position: absolute;
    inset: 0;
    background: linear-gradient(to top, rgba(0,0,0,0.35), rgba(0,0,0,0));
    pointer-events: none;
  }


  #{{ section_id }} .dwell-sv-play-icon {
    position: absolute;
    z-index: 2;
    top: 12px;
    right: 12px;
    width: 34px;
    height: 34px;
    border-radius: 50%;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    background: rgba(0,0,0,0.55);
    color: #E5E4E2;
    font-size: 13px;
    line-height: 1;
  }


  #{{ section_id }} .dwell-sv-placeholder {
    width: 100%;
    height: 100%;
    min-height: 260px;
    display: flex;
    align-items: center;
    justify-content: center;
    color: #6F4E37;
    font-size: 13px;
  }


  #{{ section_id }} .dwell-sv-product-card {
    display: flex;
    align-items: center;
    gap: 10px;
    padding: 10px;
  }


  #{{ section_id }} .dwell-sv-product-image,
  #{{ section_id }} .dwell-sv-modal-product-img {
    flex: 0 0 54px;
    width: 54px;
    height: 54px;
    display: block;
    border-radius: 8px;
    overflow: hidden;
    background: #f7f7f7;
    text-decoration: none;
  }


  #{{ section_id }} .dwell-sv-product-image img,
  #{{ section_id }} .dwell-sv-modal-product-img img {
    width: 100%;
    height: 100%;
    display: block;
    object-fit: contain;
  }


  #{{ section_id }} .dwell-sv-product-info,
  #{{ section_id }} .dwell-sv-modal-product-info {
    flex: 1;
    min-width: 0;
  }


  #{{ section_id }} .dwell-sv-product-title,
  #{{ section_id }} .dwell-sv-modal-product-title {
    display: -webkit-box;
    margin: 0;
    color: {{ section.settings.text_color }};
    font-size: 13px;
    line-height: 1.3;
    font-weight: 600;
    text-decoration: none;
    overflow: hidden;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
  }


  #{{ section_id }} .dwell-sv-product-title:hover,
  #{{ section_id }} .dwell-sv-modal-product-title:hover {
    text-decoration: none;
    color: {{ section.settings.text_color }};
  }


  #{{ section_id }} .dwell-sv-price-row {
    display: flex;
    align-items: center;
    gap: 6px;
    margin-top: 5px;
    flex-wrap: wrap;
  }


  #{{ section_id }} .dwell-sv-price {
    color: {{ section.settings.text_color }};
    font-size: 13px;
    line-height: 1.2;
    font-weight: 700;
  }


  #{{ section_id }} .dwell-sv-compare {
    color: {{ section.settings.muted_text_color }};
    font-size: 12px;
    line-height: 1.2;
    text-decoration: line-through;
  }


  #{{ section_id }} .dwell-sv-add-btn {
    width: calc(100% - 20px);
    min-height: 38px;
    margin: 0 10px 10px;
    padding: 10px 14px;
    border: 0;
    border-radius: {{ section.settings.button_radius }}px;
    background: {{ section.settings.button_background }};
    color: {{ section.settings.button_text_color }} !important;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    font-size: 13px;
    line-height: 1.2;
    font-weight: 700;
    text-align: center;
    text-decoration: none !important;
    cursor: pointer;
    appearance: none;
    -webkit-appearance: none;
  }


  #{{ section_id }} .dwell-sv-add-btn:hover {
    background: {{ section.settings.button_hover_background }};
    color: {{ section.settings.button_text_color }} !important;
    text-decoration: none !important;
  }


  #{{ section_id }} .dwell-sv-add-btn:disabled {
    opacity: 0.65;
    cursor: not-allowed;
  }


  #{{ section_id }} .dwell-sv-soldout {
    opacity: 0.65;
  }


  #{{ section_id }} .dwell-sv-nav {
    display: none;
  }


  #{{ section_id }} .dwell-sv-modal[hidden],
  #{{ section_id }} .dwell-sv-modal-panel[hidden] {
    display: none !important;
  }


  #{{ section_id }} .dwell-sv-modal {
    position: fixed;
    inset: 0;
    z-index: 999999;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 18px;
  }


  #{{ section_id }} .dwell-sv-modal-overlay {
    position: absolute;
    inset: 0;
    background: rgba(0,0,0,0.72);
  }


  #{{ section_id }} .dwell-sv-modal-content {
    position: relative;
    z-index: 2;
    width: min(100%, 920px);
    max-height: 92vh;
    overflow: auto;
    border-radius: 16px;
    background: #E5E4E2;
  }


  #{{ section_id }} .dwell-sv-modal-close {
    position: fixed;
    z-index: 3;
    top: 18px;
    right: 18px;
    width: 38px;
    height: 38px;
    border: 0;
    border-radius: 50%;
    background: #E5E4E2;
    color: #6F4E37;
    font-size: 26px;
    line-height: 1;
    cursor: pointer;
  }


  #{{ section_id }} .dwell-sv-modal-video {
    width: 100%;
    background: #6F4E37;
  }


  #{{ section_id }} .dwell-sv-modal-video video,
  #{{ section_id }} .dwell-sv-modal-video iframe,
  #{{ section_id }} .dwell-sv-modal-video img {
    display: block;
    width: 100%;
    height: auto;
    max-height: 72vh;
    aspect-ratio: {{ section.settings.video_ratio }};
    object-fit: contain;
    border: 0;
  }


  #{{ section_id }} .dwell-sv-modal-product {
    padding: 14px;
  }


  #{{ section_id }} .dwell-sv-modal-product-row {
    display: flex;
    align-items: center;
    gap: 12px;
    margin-bottom: 12px;
  }


  #{{ section_id }} .dwell-sv-modal-product-img {
    flex-basis: 64px;
    width: 64px;
    height: 64px;
  }


  #{{ section_id }} .dwell-sv-modal-product .dwell-sv-add-btn {
    width: 100%;
    margin: 0;
  }


  #{{ section_id }} .dwell-sv-empty {
    padding: 24px;
    border: 1px dashed #cccccc;
    border-radius: 10px;
    color: #6F4E37;
    text-align: center;
    font-size: 14px;
  }


  @media screen and (min-width: 750px) {
    #{{ section_id }} .dwell-sv-container {
      padding-left: {{ section.settings.side_padding_desktop }}px;
      padding-right: {{ section.settings.side_padding_desktop }}px;
    }


    #{{ section_id }} .dwell-sv-heading {
      font-size: {{ section.settings.heading_size_desktop }}px;
    }


    #{{ section_id }} .dwell-sv-card {
      flex-basis: calc((100% - ({{ section.settings.card_gap }}px * ({{ section.settings.desktop_cards }} - 1))) / {{ section.settings.desktop_cards }});
    }


    #{{ section_id }} .dwell-sv-nav {
      position: absolute;
      top: 42%;
      z-index: 2;
      transform: translateY(-50%);
      width: 38px;
      height: 38px;
      border: 1px solid #e5e5e5;
      border-radius: 50%;
      background: #E5E4E2;
      color: #6F4E37;
      display: flex;
      align-items: center;
      justify-content: center;
      font-size: 24px;
      line-height: 1;
      cursor: pointer;
      box-shadow: 0 4px 14px rgba(0,0,0,0.12);
    }


    #{{ section_id }} .dwell-sv-nav-prev {
      left: -10px;
    }


    #{{ section_id }} .dwell-sv-nav-next {
      right: -10px;
    }
  }


  @media screen and (max-width: 749px) {
    #{{ section_id }} {
      margin: {{ section.settings.margin_top_mobile }}px 0 {{ section.settings.margin_bottom_mobile }}px;
      padding: {{ section.settings.padding_top_mobile }}px 0 {{ section.settings.padding_bottom_mobile }}px;
    }
  }
</style>


<script>
  (function () {
    var section = document.getElementById('{{ section_id }}');


    if (!section || section.dataset.loaded === 'true') return;
    section.dataset.loaded = 'true';


    var track = section.querySelector('[data-sv-track]');
    var prev = section.querySelector('[data-sv-prev]');
    var next = section.querySelector('[data-sv-next]');
    var modal = section.querySelector('[data-sv-modal]');
    var closeBtn = section.querySelector('[data-sv-close]');
    var overlay = section.querySelector('[data-sv-overlay]');


    function refreshCart() {
      document.dispatchEvent(new CustomEvent('cart:refresh', { bubbles: true }));
      document.dispatchEvent(new CustomEvent('cart:updated', { bubbles: true }));
      document.dispatchEvent(new CustomEvent('cart:update', { bubbles: true }));
      document.dispatchEvent(new CustomEvent('theme:cart:refresh', { bubbles: true }));
      window.dispatchEvent(new CustomEvent('cart:refresh'));
      window.dispatchEvent(new CustomEvent('cart:updated'));
    }


    function addToCart(button) {
      var variantId = button.getAttribute('data-variant-id');
      var originalText = button.textContent;


      if (!variantId || button.disabled) return;


      button.disabled = true;
      button.textContent = 'Adding...';


      fetch('/cart/add.js', {
        method: 'POST',
        headers: {
          'Content-Type': 'application/json',
          'Accept': 'application/json'
        },
        body: JSON.stringify({
          id: Number(variantId),
          quantity: 1
        })
      })
      .then(function (response) {
        if (!response.ok) throw new Error('Cart error');
        return response.json();
      })
      .then(function () {
        button.textContent = 'Added!';
        refreshCart();


        setTimeout(function () {
          button.textContent = originalText;
          button.disabled = false;
        }, 1600);
      })
      .catch(function () {
        button.textContent = 'Try Again';


        setTimeout(function () {
          button.textContent = originalText;
          button.disabled = false;
        }, 1600);
      });
    }


    function stopModalMedia() {
      if (!modal) return;


      modal.querySelectorAll('video').forEach(function (video) {
        try {
          video.pause();
          video.currentTime = 0;
        } catch (e) {}
      });


      modal.querySelectorAll('iframe').forEach(function (iframe) {
        iframe.setAttribute('src', '');
      });
    }


    function openModal(index) {
      if (!modal) return;


      stopModalMedia();


      modal.querySelectorAll('[data-sv-panel]').forEach(function (panel) {
        panel.hidden = panel.getAttribute('data-sv-panel') !== String(index);
      });


      modal.hidden = false;
      document.documentElement.style.overflow = 'hidden';


      var activePanel = modal.querySelector('[data-sv-panel="' + index + '"]');


      if (activePanel) {
        var video = activePanel.querySelector('video');
        var iframe = activePanel.querySelector('iframe');


        if (video) {
          setTimeout(function () {
            try {
              video.play();
            } catch (e) {}
          }, 100);
        }


        if (iframe && iframe.getAttribute('data-src')) {
          iframe.setAttribute('src', iframe.getAttribute('data-src'));
        }
      }
    }


    function closeModal() {
      if (!modal) return;


      stopModalMedia();
      modal.hidden = true;
      document.documentElement.style.overflow = '';
    }


    if (track && prev) {
      prev.addEventListener('click', function () {
        track.scrollBy({
          left: -track.clientWidth * 0.8,
          behavior: 'smooth'
        });
      });
    }


    if (track && next) {
      next.addEventListener('click', function () {
        track.scrollBy({
          left: track.clientWidth * 0.8,
          behavior: 'smooth'
        });
      });
    }


    section.addEventListener('click', function (event) {
      var openButton = event.target.closest('[data-sv-open]');
      var addButton = event.target.closest('[data-sv-add]');


      if (openButton) {
        event.preventDefault();
        openModal(openButton.getAttribute('data-modal-index'));
      }


      if (addButton) {
        event.preventDefault();
        addToCart(addButton);
      }
    });


    if (closeBtn) {
      closeBtn.addEventListener('click', closeModal);
    }


    if (overlay) {
      overlay.addEventListener('click', closeModal);
    }


    document.addEventListener('keydown', function (event) {
      if (event.key === 'Escape' && modal && !modal.hidden) {
        closeModal();
      }
    });
  })();
</script>



<section
  id="SingleBanner-{{ section.id }}"
  class="single-image-banner"
>
  {% liquid
    assign desktop_image = section.settings.desktop_image
    assign mobile_image = section.settings.mobile_image
    assign image_alt = section.settings.alt_text | default: desktop_image.alt
  %}

  {% if section.settings.link != blank %}
    <a
      href="{{ section.settings.link }}"
      class="single-image-banner__link"
    >
  {% endif %}

  {% if desktop_image != blank %}
    <picture class="single-image-banner__picture">
      {% if mobile_image != blank %}
        <source
          media="(max-width: 748px)"
          srcset="
            {{ mobile_image | image_url: width: 375 }} 375w,
            {{ mobile_image | image_url: width: 750 }} 750w,
            {{ mobile_image | image_url: width: 1100 }} 1100w,
            {{ mobile_image | image_url: width: 1500 }} 1500w
          "
          sizes="100vw"
          width="{{ mobile_image.width }}"
          height="{{ mobile_image.height }}"
        >
      {% endif %}

      <img
        src="{{ desktop_image | image_url: width: 1920 }}"
        srcset="
          {{ desktop_image | image_url: width: 750 }} 750w,
          {{ desktop_image | image_url: width: 1100 }} 1100w,
          {{ desktop_image | image_url: width: 1500 }} 1500w,
          {{ desktop_image | image_url: width: 1920 }} 1920w,
          {{ desktop_image | image_url: width: 2560 }} 2560w,
          {{ desktop_image | image_url: width: 3840 }} 3840w
        "
        sizes="100vw"
        width="{{ desktop_image.width }}"
        height="{{ desktop_image.height }}"
        alt="{{ image_alt | escape }}"
        {% if section.index == 1 %}
          loading="eager"
        {% else %}
          loading="lazy"
        {% endif %}
      >
    </picture>
  {% else %}
    {{ 'lifestyle-1' | placeholder_svg_tag: 'single-image-banner__placeholder' }}
  {% endif %}

  {% if section.settings.link != blank %}
    </a>
  {% endif %}
</section>

{% stylesheet %}
  .single-image-banner {
    width: 100%;
    margin: 0;
    padding: 0;
  }

  .single-image-banner__link,
  .single-image-banner__picture {
    display: block;
    width: 100%;
  }

  .single-image-banner__picture img,
  .single-image-banner__placeholder {
    display: block;
    width: 100%;
    max-width: 100%;
    height: auto;
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Single Image Banner",
  "tag": "section",
  "class": "single-image-banner-section",
  "settings": [
    {
      "type": "image_picker",
      "id": "desktop_image",
      "label": "Desktop image"
    },
    {
      "type": "image_picker",
      "id": "mobile_image",
      "label": "Mobile image",
      "info": "Optional. Below 749px, this image is shown. If empty, the desktop image is used."
    },
    {
      "type": "url",
      "id": "link",
      "label": "Banner link"
    },
    {
      "type": "text",
      "id": "alt_text",
      "label": "Image description",
      "info": "Describe the banner for accessibility."
    }
  ],
  "presets": [
    {
      "name": "Single Image Banner"
    }
  ]
}
{% endschema %}
{{ 'silkspire-mobile-navigation.css' | asset_url | stylesheet_tag }}
<script src="{{ 'silkspire-mobile-navigation.js' | asset_url }}" defer="defer"></script>
<nav class="mobile-bottom-nav" aria-label="Mobile navigation" data-mobile-bottom-nav>
  <a href="{{ routes.root_url }}" {% if request.page_type == 'index' %}aria-current="page"{% endif %}>
    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.3" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m3 10 9-7 9 7v11h-6v-8H9v8H3Z"/></svg>
    <span>Home</span>
  </a>
  <a href="{{ routes.all_products_collection_url }}?sort_by=created-descending">
    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.3" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m14 3 2.5 6.5L23 12l-6.5 2.5L14 21l-2.5-6.5L5 12l6.5-2.5Z"/><path d="m4 1 1 3 3 1-3 1-1 3-1-3-3-1 3-1Zm0 15 1 3 3 1-3 1-1 3-1-3-3-1 3-1Z"/></svg>
    <span>New</span>
  </a>
  <a href="{{ routes.search_url }}?view=wishlist">
    {{ 'icon-wishlist.svg' | inline_asset_content }}
    <span>Wishlist</span>
  </a>
  <a href="{{ routes.account_url }}" {% if request.page_type contains 'customers/' %}aria-current="page"{% endif %}>
    {{ 'icon-account.svg' | inline_asset_content }}
    <span>Account</span>
  </a>
</nav>

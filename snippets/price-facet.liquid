{%- doc -%}
  Renders the minimum and maximum inputs for a price-range facet.

  @param {filter} filter - The price-range filter that supplies parameter names, selected values, and the maximum price.
  @param {string} id_prefix - A prefix that makes the minimum and maximum input IDs unique.
  @param {string} [filter_type] - The facet layout. Set to `vertical` to omit the second currency label; other values use the non-vertical layout.

  @example
  {% render 'price-facet', filter: filter, id_prefix: 'Filter-', filter_type: 'vertical' %}
{%- enddoc -%}
{%- if request.page_type == 'collection' -%}
  {%- assign range_maximum = filter.range_max | divided_by: 100.0 -%}
  <silkspire-price-slider class="collection-price-slider" data-max="{{ range_maximum }}" data-currency="{{ cart.currency.iso_code }}">
    <div class="collection-price-slider__values"><span data-range-low></span><span data-range-high></span></div>
    <div class="collection-price-slider__track">
      <input type="range" min="0" max="{{ range_maximum }}" step="0.01" value="{{ filter.min_value.value | default: 0 | divided_by: 100.0 }}" aria-label="Minimum price" data-range-min {% if range_maximum == 0 %}disabled{% endif %}>
      <input type="range" min="0" max="{{ range_maximum }}" step="0.01" value="{{ filter.max_value.value | default: filter.range_max | divided_by: 100.0 }}" aria-label="Maximum price" data-range-max {% if range_maximum == 0 %}disabled{% endif %}>
    </div>
  </silkspire-price-slider>
{%- endif -%}
<span class="field-currency">{{ cart.currency.symbol }}</span>

<div class="field">
  <input
    class="field__input"
    name="{{ filter.min_value.param_name }}"
    id="{{ id_prefix }}{{ filter.label | escape }}-GTE"
    {%- if filter.min_value.value -%}
      value="{{ filter.min_value.value | money_without_currency }}"
    {%- endif -%}
    type="text"
    inputmode="decimal"
    placeholder="0"
    data-pattern="\d| |,|\."
    data-min="0"
    data-max="{{ filter.range_max | money_without_currency }}"
  >
  <label class="field__label" for="{{ id_prefix }}{{ filter.label | escape }}-GTE">
    {{- 'products.facets.from' | t -}}
  </label>
</div>

{%- if filter_type != 'vertical' -%}
  <span class="field-currency">{{ cart.currency.symbol }}</span>
{%- endif -%}

<div class="field">
  <input
    class="field__input"
    name="{{ filter.max_value.param_name }}"
    id="{{ id_prefix }}{{ filter.label | escape }}-LTE"
    {%- if filter.max_value.value -%}
      value="{{ filter.max_value.value | money_without_currency }}"
    {%- endif -%}
    type="text"
    inputmode="decimal"
    placeholder="{{ filter.range_max | money_without_currency }}"
    data-pattern="\d| |,|\."
    data-min="0"
    data-max="{{ filter.range_max | money_without_currency }}"
  >
  <label class="field__label" for="{{ id_prefix }}{{ filter.label | escape }}-LTE">
    {{- 'products.facets.to' | t -}}
  </label>
</div>
